
import io
import json
import time

import torch
from fastapi import FastAPI, File, HTTPException, UploadFile
from PIL import Image, UnidentifiedImageError
from qwen_vl_utils import process_vision_info
from transformers import (
    AutoProcessor,
    Qwen2_5_VLForConditionalGeneration,
)

# --------------------------------------------------
# Configuration
# --------------------------------------------------

MODEL_NAME = "Qwen/Qwen2.5-VL-3B-Instruct"

MAX_NEW_TOKENS = 50

# Visual input limits used by Qwen's processor.
MIN_PIXELS = 256 * 28 * 28
MAX_PIXELS = 512 * 28 * 28

# Maximum uploaded image size: 20 MB.
MAX_UPLOAD_BYTES = 20 * 1024 * 1024

# --------------------------------------------------
# FastAPI
# --------------------------------------------------

app = FastAPI(title="Qwen Image Tagging API")

# --------------------------------------------------
# Check GPU
# --------------------------------------------------

if not torch.cuda.is_available():
    raise RuntimeError(
        "CUDA is not available. Check your PyTorch installation."
    )

print("GPU:", torch.cuda.get_device_name(0))

print(
    "VRAM:",
    round(
        torch.cuda.get_device_properties(0).total_memory
        / 1024**3,
        2,
    ),
    "GB",
)

print("PyTorch:", torch.__version__)
print("CUDA version:", torch.version.cuda)

# --------------------------------------------------
# Load model once
# --------------------------------------------------

print("\nLoading Qwen model...")
load_start = time.time()

model = Qwen2_5_VLForConditionalGeneration.from_pretrained(
    MODEL_NAME,
    torch_dtype=torch.float16,
    device_map="cuda",
    attn_implementation="sdpa",
)

model.eval()

model.generation_config.temperature = 1.0

processor = AutoProcessor.from_pretrained(
    MODEL_NAME,
    use_fast=True,
    min_pixels=MIN_PIXELS,
    max_pixels=MAX_PIXELS,
)

print(
    f"Model loaded in {time.time() - load_start:.1f} seconds"
)

print("Model device:", model.device)
print("Qwen API is ready.")

# --------------------------------------------------
# Health check
# --------------------------------------------------

@app.get("/health")
def health():
    return {
        "status": "ok",
        "model": MODEL_NAME,
        "device": str(model.device),
    }

# --------------------------------------------------
# Generate image tags
# --------------------------------------------------

@app.post("/tag-image")
async def tag_image(file: UploadFile = File(...)):

    # --------------------------------------------------
    # Validate upload
    # --------------------------------------------------

    if (
        file.content_type
        and not file.content_type.startswith("image/")
    ):
        raise HTTPException(
            status_code=415,
            detail="Uploaded file must be an image.",
        )

    image_bytes = await file.read(MAX_UPLOAD_BYTES + 1)

    if len(image_bytes) > MAX_UPLOAD_BYTES:
        raise HTTPException(
            status_code=413,
            detail="Image exceeds the 20 MB limit.",
        )

    if not image_bytes:
        raise HTTPException(
            status_code=400,
            detail="Uploaded image is empty.",
        )

    # --------------------------------------------------
    # Open existing converted image
    # --------------------------------------------------

    try:
        image = Image.open(io.BytesIO(image_bytes))
        image.load()

    except (UnidentifiedImageError, OSError):
        raise HTTPException(
            status_code=400,
            detail="Invalid or unsupported image.",
        )

    print(
        f"\nReceived image: {image.width} x {image.height}"
    )

    # --------------------------------------------------
    # Prepare prompt
    # --------------------------------------------------

    messages = [
        {
            "role": "user",
            "content": [
                {
                    "type": "image",
                    "image": image,
                },
                {
                    "type": "text",
                    "text": (
                        "Analyze this photo for a personal photo library. "
                        "Return only a valid JSON array containing 5 to 10 "
                        "lowercase strings representing searchable tags. "
                        "Include visible objects, activities, setting, "
                        "and scene. Do not invent details. "
                        'Example: ["dog", "park", "outdoors"].'
                    ),
                },
            ],
        }
    ]

    # --------------------------------------------------
    # Process image and conversation
    # --------------------------------------------------

    try:
        prompt = processor.apply_chat_template(
            messages,
            tokenize=False,
            add_generation_prompt=True,
        )

        image_inputs, video_inputs = process_vision_info(
            messages
        )

        inputs = processor(
            text=[prompt],
            images=image_inputs,
            videos=video_inputs,
            padding=True,
            return_tensors="pt",
        ).to(model.device)

        print("Input token count:", inputs["input_ids"].shape[1])
        print("Generating tags...")

        # --------------------------------------------------
        # Generate tags
        # --------------------------------------------------

        if torch.cuda.is_available():
            torch.cuda.synchronize()

        start = time.time()

        with torch.inference_mode():
            output = model.generate(
                **inputs,
                max_new_tokens=MAX_NEW_TOKENS,
                do_sample=False,
                use_cache=True,
            )

        if torch.cuda.is_available():
            torch.cuda.synchronize()

        elapsed = time.time() - start

        input_length = inputs["input_ids"].shape[1]

        new_tokens = output[:, input_length:]

        result = processor.batch_decode(
            new_tokens,
            skip_special_tokens=True,
            clean_up_tokenization_spaces=False,
        )[0].strip()

        print("Raw response:", repr(result))
        print(f"Analysis took {elapsed:.1f} seconds")

        # --------------------------------------------------
        # Validate tags
        # --------------------------------------------------

        # Handle a JSON code fence if the model returns one.
        if result.startswith("```"):
            result = result.removeprefix("```json")
            result = result.removeprefix("```")
            result = result.removesuffix("```").strip()

        tags = json.loads(result)

        if not isinstance(tags, list):
            raise ValueError(
                "The model response must be a JSON array."
            )

        if not all(isinstance(tag, str) for tag in tags):
            raise ValueError(
                "Every tag must be a string."
            )

        tags = list(
            dict.fromkeys(
                tag.strip().lower()
                for tag in tags
                if tag.strip()
            )
        )[:10]

        if not tags:
            raise ValueError(
                "The model returned no usable tags."
            )

        # --------------------------------------------------
        # Return JSON to NestJS
        # --------------------------------------------------

        response = {
            "tags": tags,
            "analysisSeconds": round(elapsed, 2),
        }

        print("Final tags:", json.dumps(tags))

        return response

    except (json.JSONDecodeError, ValueError) as error:
        print("Invalid model response:", str(error))

        raise HTTPException(
            status_code=502,
            detail="The model did not return valid tags.",
        )

    except Exception as error:
        print("Image tagging failed:", repr(error))

        raise HTTPException(
            status_code=500,
            detail="Image tagging failed.",
        )

    finally:
        image.close()
        await file.close()
